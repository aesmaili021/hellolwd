# Railway / any Postgres — when set, news/events/RSS persist here
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# DATABASE_SSL=false

# Supabase (public client — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Aliases also accepted by the server client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Admin desk — required on Railway / production
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=
# Change this so /admin/login is not the public gate
ADMIN_LOGIN_PATH=/admin/login
# ADMIN_COOKIE_NAME=lwd_desk

# RSS ingest: every 3 hours locally; on Vercel use the cron route
RSS_INTERVAL_HOURS=3
CRON_SECRET=change-me-before-deploy

# 1) Claude on Azure (Microsoft Foundry) — summarize + translate, then post
# Portal: https://ai.azure.com → Models → deploy Claude Haiku (cheap) or Sonnet
# Endpoint looks like: https://YOUR-RESOURCE.services.ai.azure.com/anthropic
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_CLAUDE_DEPLOYMENT=claude-haiku-4-5

# 2) Google AI Studio if Azure is empty
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 3) Direct Anthropic Claude if both above fail
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# 3) Free machine-translate fallback (no key)
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
# TRANSLATE_EMAIL=hello@hellolwd.nl
