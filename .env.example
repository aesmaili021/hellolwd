# Supabase (public client — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Aliases also accepted by the server client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Admin desk at /admin — change this before any public deploy
ADMIN_PASSWORD=lwd-admin

# RSS ingest: every 3 hours locally; on Vercel use the cron route
RSS_INTERVAL_HOURS=3
CRON_SECRET=change-me-before-deploy

# 1) Google AI Studio (Gemini) — primary translator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2) Optional Claude if Gemini quota is empty
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# 3) Free machine-translate fallback (no key)
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
# TRANSLATE_EMAIL=hello@hellolwd.nl
